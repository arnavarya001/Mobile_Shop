<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Mobile — Mobile Store</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="center-page">
    <div class="form-shell">

      <a href="/getdata" class="back-link">&larr; Back to inventory</a>

      <div class="ticket">
        <div class="ticket-pad">

          <div class="eyebrow">Edit entry</div>
          <h2 class="display" style="font-size:22px;margin-bottom:22px;">Edit Mobile</h2>

          <form action="/update/<%= data._id %>" method="POST">

            <div class="field">
              <label for="brand">Brand</label>
              <input type="text" id="brand" name="brand" value="<%= data.brand %>" required>
            </div>

            <div class="field">
              <label for="model">Model</label>
              <input type="text" id="model" name="model" value="<%= data.model %>" required>
            </div>

            <div class="field">
              <label for="ram">RAM (GB)</label>
              <input type="number" id="ram" name="ram" class="mono-input" value="<%= data.ram %>" min="1" required>
            </div>

            <div class="field">
              <label for="storage">Storage (GB)</label>
              <input type="number" id="storage" name="storage" class="mono-input" value="<%= data.storage %>" min="1" required>
            </div>

            <div class="field">
              <label for="price">Price (&#8377;)</label>
              <input type="number" id="price" name="price" class="mono-input" value="<%= data.price %>" min="0" required>
            </div>

            <button type="submit" class="submit-btn">Update Mobile</button>

          </form>

        </div>
      </div>

    </div>
  </div>

</body>
</html>
