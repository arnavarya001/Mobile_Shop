<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mobile Store Management</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="center-page">
    <div class="home-shell">

      <div class="brand" style="justify-content:center;">
        <div class="logo-mark"></div>
        <div style="text-align:left;">
          <div class="eyebrow">Inventory System</div>
          <div class="brand-name" style="font-size:26px;">Mobile Store</div>
        </div>
      </div>

      <div class="home-tiles">

        <a href="/getdata" class="ticket tile">
          <div class="ticket-pad">
            <div class="eyebrow">Browse</div>
            <div class="tile-title">View Inventory</div>
            <div class="tile-desc">See every phone on the shelf, search by brand</div>
          </div>
        </a>

        <a href="/insertdata" class="ticket tile accent">
          <div class="ticket-pad">
            <div class="eyebrow">Stock in</div>
            <div class="tile-title">Add Mobile</div>
            <div class="tile-desc">Log a new phone into the catalogue</div>
          </div>
        </a>

      </div>
    </div>
  </div>

</body>
</html>
